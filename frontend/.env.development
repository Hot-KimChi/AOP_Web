# .env.development
#
# NEXT_PUBLIC_API_BASE_URL 은 기본적으로 "지정하지 않는다".
# 지정하지 않으면 src/lib/apiBase.js 가 브라우저가 접속한 호스트를 기준으로
# API 주소를 자동으로 만든다.
#   - http://localhost:3000  으로 열면 -> http://localhost:5000
#   - http://<서버IP>:3000   으로 열면 -> http://<서버IP>:5000
#
# 과거에 여기에 http://localhost:5000 을 고정해 두어, 다른 PC 에서 서버 IP 로
# 접속하면 자기 PC 의 5000 번 포트로 요청이 가 로그인이 항상 실패했다.
#
# 백엔드가 프론트와 "다른 호스트/포트"에 있는 경우에만 아래 주석을 풀고 지정한다.
# NEXT_PUBLIC_API_BASE_URL=http://<백엔드호스트>:5000
